{
  "name": "@neyu703/react-lib",
  "version": "0.4.0",
  "description": "Gemeinsame React-Komponenten, Tokens und Sass-Mixins für KTE-Programme",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css",
    "./scss/base": "./scss/base.scss",
    "./scss/styles": "./scss/styles.scss",
    "./scss/mixins": "./scss/_mixins.scss",
    "./package.json": "./package.json",
    "./search-field.css": "./dist/search-field.css"
  },
  "files": [
    "dist",
    "scss",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json && sass --no-source-map --style=expanded scss/base.scss:dist/base.css scss/styles.scss:dist/styles.css scss/search-field-page.scss:dist/search-field.css",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.105.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
