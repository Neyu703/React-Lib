{
  "name": "@neyu703/react-lib",
  "version": "0.1.0",
  "description": "Gemeinsame React-Komponenten für KTE-Programme",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": ["dist", "src/styles.css", "README.md"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "typescript": "7.0.2"
  }
}
