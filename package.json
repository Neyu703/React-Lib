{
  "name": "@neyu703/react-lib",
  "version": "0.3.0",
  "description": "Gemeinsame React-Komponenten, Tokens und Sass-Mixins für KTE-Programme",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css",
    "./scss/base": "./scss/base.scss",
    "./scss/styles": "./scss/styles.scss",
    "./scss/mixins": "./scss/_mixins.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scss",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json && sass --no-source-map --style=expanded scss/base.scss:dist/base.css scss/styles.scss:dist/styles.css",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "sass": "1.105.0",
    "typescript": "7.0.2"
  }
}
